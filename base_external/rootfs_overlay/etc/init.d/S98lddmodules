#! /bin/sh

case "$1" in 
    start)
        echo "Starting ldd-modules"
        depmod -a
        cd /lib/modules/6.1.44/extra/ 2>/dev/null || cd /lib/modules/*/extra
        /usr/bin/module_load faulty
        /usr/bin/scull_load
        modprobe hello
        ;;
    stop)
        echo "Stopping ldd-modules"
        /usr/bin/module_unload faulty
        /usr/bin/scull_unload
        rmmod hello
        ;;
    *)
        echo "Usage: $0 {start|stop}"
    exit 1
esac
exit 0