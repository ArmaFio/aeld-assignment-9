#! /bin/sh

case "$1" in 
    start)
        echo "Starting aesd-modules"
        /usr/bin/aesdchar_load
        /usr/bin/aesdsocket -d
        ;;
    stop)
        echo "Stopping ldd-modules"
        killall -9 /usr/bin/aesdsocket
        /usr/bin/aesdchar_unload
        ;;
    *)
        echo "Usage: $0 {start|stop}"
    exit 1
esac
exit 0